{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rullst.dev/schemas/security-event-v1.schema.json",
  "title": "Rullst LiveSecurityEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "details",
    "client_ip",
    "timestamp_str",
    "verified_hmac"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_type": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{1,64}$",
      "maxLength": 64
    },
    "details": {
      "type": "string",
      "maxLength": 2048,
      "x-rullst-maxUtf8Bytes": 2048
    },
    "client_ip": {
      "oneOf": [
        { "const": "unknown" },
        { "type": "string", "format": "ipv4" },
        { "type": "string", "format": "ipv6" }
      ]
    },
    "timestamp_str": {
      "type": "string",
      "format": "date-time"
    },
    "verified_hmac": {
      "type": "boolean"
    }
  }
}
