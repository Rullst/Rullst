use ring::hmac;
use rullst::server::HeaderMap;
use rullst_privacy::age_assurance::{AgeError, AgePolicy, ChallengeTokens, DeclarationGate, RiskLevel, SubjectBinding, __STORE_TYPE__};

pub struct AgeGateState {
    pub(super) policy: AgePolicy,
    pub(super) tokens: ChallengeTokens,
    pub(super) gate: DeclarationGate<__STORE_TYPE__>,
    binding_key: hmac::Key,
    tenant: String,
}

impl AgeGateState {
    pub(super) async fn from_env() -> Result<Self, AgeError> {
        let encoded = std::env::var("RULLST_AGE_KEY_HEX").map_err(|_| AgeError::InvalidConfiguration)?;
        if encoded.len() != 64 {
            return Err(AgeError::InvalidConfiguration);
        }
        let key = hex::decode(encoded).map_err(|_| AgeError::InvalidConfiguration)?;
        let key_id = std::env::var("RULLST_AGE_KEY_ID").map_err(|_| AgeError::InvalidConfiguration)?;
        let tokens = ChallengeTokens::new(key_id, &key)?;
        let database = std::env::var("RULLST_AGE_REPLAY_DATABASE").map_err(|_| AgeError::InvalidConfiguration)?;
        let store = __STORE_OPEN__;
        Ok(Self {
            policy: AgePolicy::new(__POLICY_VERSION__, RiskLevel::Low, __MINIMUM_AGE__ )?,
            tokens,
            gate: DeclarationGate::new(store)?,
            binding_key: hmac::Key::new(hmac::HMAC_SHA256, &key),
            tenant: __TENANT_REF__.to_owned(),
        })
    }

    pub(super) fn binding(&self, user_id: i32, headers: &HeaderMap) -> Result<SubjectBinding, AgeError> {
        if user_id <= 0 {
            return Err(AgeError::BindingMismatch);
        }
        // user_id is supplied only by the existing authenticated User lookup.
        let cookie = rullst::auth::extract_session_cookie(headers).ok_or(AgeError::BindingMismatch)?;
        if cookie.is_empty() || cookie.len() > 4096 {
            return Err(AgeError::BindingMismatch);
        }
        SubjectBinding::new(
            self.reference(b"subject", &[self.tenant.as_bytes(), &user_id.to_be_bytes()]),
            self.reference(b"tenant", &[self.tenant.as_bytes()]),
            self.reference(b"session", &[self.tenant.as_bytes(), cookie.as_bytes()]),
            "saas-dashboard", "dashboard-view",
        )
    }

    fn reference(&self, field: &[u8], parts: &[&[u8]]) -> String {
        let mut context = hmac::Context::with_key(&self.binding_key);
        context.update(b"rullst.age-web-binding.v1\0");
        context.update(field);
        for part in parts {
            context.update(&(part.len() as u64).to_be_bytes());
            context.update(part);
        }
        hex::encode(context.sign().as_ref())
    }
}
