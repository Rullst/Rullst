//! Explicit one-time age replay-store initialization (PostgreSQL), generated by
//! `cargo rullst make:age-gate --replay-store postgres`. No web server is
//! started. Run it once in a deployment step with `RULLST_AGE_REPLAY_DATABASE`
//! exported; it creates only an absent schema and validates an existing one.
//! Application startup only connects.
use rullst_privacy::age_assurance::{AgeError, PostgresReplayStore};

#[rullst::runtime::main]
async fn main() -> Result<(), AgeError> {
    let database = std::env::var("RULLST_AGE_REPLAY_DATABASE")
        .ok().filter(|value| !value.is_empty()).ok_or(AgeError::InvalidConfiguration)?;
    let store = PostgresReplayStore::initialize(database, 10_000).await?;
    store.close().await;
    println!("Initialized (or validated) the PostgreSQL age replay store. Application startup only connects to it.");
    Ok(())
}
