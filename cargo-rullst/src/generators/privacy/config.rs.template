use rullst_privacy::consent::{ConsentError, ConsentGate, ConsentPurpose, ConsentSubject, SqliteConsentStore};
use super::proof::ProofKey;

/// Fixed at generation by `--tenant-ref`; no request input selects the tenant.
pub(super) const TENANT_REF: &str = __TENANT_REF__;
pub(super) const PURPOSE_ID: &str = "personalized-greeting";
pub(super) const NOTICE_VERSION: &str = __NOTICE_VERSION__;
pub(super) const VALIDITY_SECONDS: i64 = __VALIDITY_SECONDS__;

pub struct PrivacyState {
    pub(super) gate: ConsentGate<SqliteConsentStore>,
    pub(super) purpose: ConsentPurpose,
    pub(super) proof: ProofKey,
}

impl PrivacyState {
    pub(super) async fn from_env() -> Result<Self, ConsentError> {
        let proof = ProofKey::from_env()?;
        let database = std::env::var_os("RULLST_PRIVACY_DATABASE")
            .filter(|value| !value.is_empty()).ok_or(ConsentError::InvalidConfiguration)?;
        let store = SqliteConsentStore::open(std::path::Path::new(&database), 10_000).await?;
        Ok(Self { gate: ConsentGate::new(store)?, purpose: ConsentPurpose::new(PURPOSE_ID, NOTICE_VERSION)?, proof })
    }
}

/// The subject is the authenticated user in the fixed tenant, never request input.
pub(super) fn subject(user_id: i32) -> Result<ConsentSubject, ConsentError> {
    if user_id <= 0 { return Err(ConsentError::BindingMismatch); }
    ConsentSubject::new(user_id.to_string(), TENANT_REF)
}
