use rullst::async_runtime::tokio::sync::OnceCell;
use rullst::config::Environment;
use rullst::connect::ConnectUser;
use rullst::connect::challenge::{
    ChallengeCookie, ChallengeError, LoginError, LoginOptions, ReturnPath, SqlChallengeStore,
    begin_login, finish_login,
};
use rullst::connect::extractors::AuthCallback;
use rullst::connect::provider::Provider;
use rullst::server::{Extension, HeaderMap, HeaderValue, IntoResponse, Redirect, Response, StatusCode, header};

/// Sign-in attempts the database keeps at once; more are refused until
/// some finish or expire (each lives at most ten minutes).
const MAX_LIVE_CHALLENGES: u32 = 10_000;
/// Where a sign-in lands when it did not start with a `?next=` page.
const DEFAULT_RETURN_PATH: &str = "/dashboard";
/// Where callbacks land in development when neither the provider's redirect
/// URL nor `RULLST_PUBLIC_ORIGIN` is set.
const DEVELOPMENT_ORIGIN: &str = "http://localhost:3000";

const UNAVAILABLE: &str = "Sign-in is temporarily unavailable. Try again in a moment.";
const EXPIRED: &str = "That sign-in link expired or was already used. Start again.";
const UNVERIFIED: &str = "That sign-in could not be verified. Start again.";
const CANCELLED: &str = "Sign-in was cancelled.";
const FAILED: &str = "Sign-in with that provider failed. Try again.";
const UNVERIFIED_EMAIL: &str = "The provider did not confirm this email address, so it cannot sign in here.";
const EXISTING_ACCOUNT: &str = "An account already uses this email address. Sign in with your password.";
/// The password login's message when an account cannot start a session.
const SESSION_ERROR: &str = "Error starting session";

/// The login challenges of every provider, in the application database.
pub(crate) type ChallengeStore = SqlChallengeStore<__CHALLENGE_DATABASE__>;
static CHALLENGES: OnceCell<ChallengeStore> = OnceCell::const_new();

/// The challenge table, created on first use.
pub(crate) async fn challenges() -> Result<&'static ChallengeStore, ChallengeError> {
    CHALLENGES
        .get_or_try_init(|| async {
            let pool = rullst::db::Orm::pool()
                .map_err(|_| ChallengeError::StorageUnavailable("database pool"))?;
            ChallengeStore::open(pool.clone(), MAX_LIVE_CHALLENGES).await
        })
        .await
}

/// The running environment; unreadable configuration counts as production.
pub(crate) fn environment() -> Environment {
    rullst::config::RullstConfig::global()
        .environment()
        .unwrap_or(Environment::Production)
}

/// A setting from the process environment, then `.env`; blank is unset.
pub(crate) fn setting(name: &str) -> Result<Option<String>, rullst::config::ConfigError> {
    Ok(rullst::config::project_setting(name)?
        .map(|value| value.trim().to_owned())
        .filter(|value| !value.is_empty()))
}

/// The callback URL to register with the provider: `explicit`, else
/// `RULLST_PUBLIC_ORIGIN` + `/auth/<provider>/callback`, else the development
/// origin. Staging and production refuse to guess.
pub(crate) fn redirect_url(
    provider: &str,
    explicit: Option<String>,
    public_origin: Option<String>,
    environment: Environment,
) -> Result<String, String> {
    if let Some(explicit) = explicit {
        return Ok(explicit);
    }
    let origin = match public_origin {
        Some(origin) => origin.trim_end_matches('/').to_owned(),
        None if !environment.requires_secure_defaults() => DEVELOPMENT_ORIGIN.to_owned(),
        None => {
            return Err(format!(
                "set RULLST_PUBLIC_ORIGIN or the {provider} redirect URL before enabling {provider} sign-in"
            ));
        }
    };
    Ok(format!("{origin}/auth/{provider}/callback"))
}

/// The challenge cookie of `/auth/<provider>`: `Secure` in staging and
/// production (and on every HTTPS request, which Rullst Core adds).
pub(crate) fn challenge_cookie(provider: &str) -> Result<ChallengeCookie, ChallengeError> {
    ChallengeCookie::new(
        format!("/auth/{provider}"),
        environment().requires_secure_defaults(),
    )
}

/// What the login page needs to render an error.
pub(crate) struct PageContext {
    csrf: String,
    nonce: String,
}

pub(crate) fn page_context(
    headers: &HeaderMap,
    csrf: &Option<Extension<rullst::security::CsrfToken>>,
    csp_nonce: &Option<Extension<rullst::security::CspNonce>>,
) -> PageContext {
    let csrf = csrf
        .as_ref()
        .map(|Extension(token)| token.as_str().to_owned())
        .unwrap_or_else(|| get_csrf_token(headers));
    PageContext {
        csrf,
        nonce: get_csp_nonce(csp_nonce).to_owned(),
    }
}

/// The login page with `message`, clearing the provider's challenge cookie.
pub(crate) fn refused(page: &PageContext, provider: &str, status: StatusCode, message: &str) -> Response {
    let mut response = (status, auth::login_page(&page.csrf, Some(message), None, &page.nonce)).into_response();
    if let Ok(value) = challenge_cookie(provider).and_then(|cookie| {
        HeaderValue::from_str(&cookie.clear()).map_err(|_| ChallengeError::Invalid("cookie"))
    }) {
        response.headers_mut().append(header::SET_COOKIE, value);
    }
    response
}

/// A `303 See Other` to `target` that also sets `cookies`.
fn redirect_with_cookies(target: &str, cookies: &[String]) -> Response {
    let mut response = Redirect::to(target).into_response();
    for cookie in cookies {
        let Ok(value) = HeaderValue::from_str(cookie) else {
            return (StatusCode::INTERNAL_SERVER_ERROR, "Invalid cookie").into_response();
        };
        response.headers_mut().append(header::SET_COOKIE, value);
    }
    response
}

/// Stores a fresh challenge and sends the browser to the provider (in mock
/// mode, straight back to the callback). `next` names a same-site page to
/// return to; anything else is ignored. `cross_site_post` is for a provider
/// that POSTs the callback from its own site (Apple), whose challenge cookie
/// must be `SameSite=None; Secure`.
pub(crate) async fn start<P: Provider + ?Sized>(
    provider_name: &'static str,
    provider: &P,
    options: LoginOptions,
    next: Option<&str>,
    page: &PageContext,
    cross_site_post: bool,
) -> Response {
    let cookie = challenge_cookie(provider_name).map(|cookie| {
        if cross_site_post { cookie.for_cross_site_post() } else { cookie }
    });
    let (store, cookie) = match (challenges().await, cookie) {
        (Ok(store), Ok(cookie)) => (store, cookie),
        (Err(error), _) | (_, Err(error)) => {
            eprintln!("{provider_name} sign-in could not start: {error}");
            return refused(page, provider_name, StatusCode::SERVICE_UNAVAILABLE, UNAVAILABLE);
        }
    };
    let options = match next.map(ReturnPath::parse) {
        Some(Ok(path)) => options.with_return_to(path),
        _ => options,
    };
    match begin_login(store, provider, options).await {
        Ok(redirect) => redirect_with_cookies(redirect.url(), &[redirect.set_cookie(&cookie)]),
        Err(error) => {
            eprintln!("{provider_name} sign-in could not start: {error}");
            refused(page, provider_name, StatusCode::SERVICE_UNAVAILABLE, UNAVAILABLE)
        }
    }
}

/// Consumes the challenge named by the cookie, validates the callback,
/// resolves the account and signs it in. `first_login_name` is a display
/// name the provider sent outside its verified profile (Apple, on the first
/// authorization only), used when the profile has none.
pub(crate) async fn complete<P: Provider + ?Sized>(
    provider_name: &'static str,
    provider: &P,
    headers: &HeaderMap,
    callback: &AuthCallback,
    page: &PageContext,
    first_login_name: Option<String>,
) -> Response {
    let store = match challenges().await {
        Ok(store) => store,
        Err(error) => {
            eprintln!("{provider_name} sign-in challenge store failed: {error}");
            return refused(page, provider_name, StatusCode::SERVICE_UNAVAILABLE, UNAVAILABLE);
        }
    };
    let challenge_id = ChallengeCookie::read(
        headers
            .get_all(header::COOKIE)
            .iter()
            .filter_map(|value| value.to_str().ok()),
    );
    let login = match finish_login(store, provider, provider_name, challenge_id.as_deref(), callback).await {
        Ok(login) => login,
        Err(error) => {
            let (status, message) = match &error {
                LoginError::MissingChallenge
                | LoginError::Challenge(ChallengeError::NotFound | ChallengeError::Expired) => {
                    (StatusCode::BAD_REQUEST, EXPIRED)
                }
                LoginError::Challenge(_) => (StatusCode::SERVICE_UNAVAILABLE, UNAVAILABLE),
                LoginError::Denied(_) => (StatusCode::BAD_REQUEST, CANCELLED),
                LoginError::Exchange(_) => (StatusCode::BAD_GATEWAY, FAILED),
                _ => (StatusCode::BAD_REQUEST, UNVERIFIED),
            };
            eprintln!("{provider_name} sign-in refused: {error}");
            return refused(page, provider_name, status, message);
        }
    };
    let (mut profile, return_to) = login.into_parts();
    if profile.name.trim().is_empty()
        && let Some(name) = first_login_name
    {
        profile.name = name;
    }
    let user = match resolve_account(provider_name, &profile, EXISTING_ACCOUNT_POLICY).await {
        Ok(user) => user,
        Err(AccountError::UnverifiedEmail) => {
            return refused(page, provider_name, StatusCode::FORBIDDEN, UNVERIFIED_EMAIL);
        }
        Err(AccountError::ExistingAccount) => {
            return refused(page, provider_name, StatusCode::CONFLICT, EXISTING_ACCOUNT);
        }
        Err(AccountError::InvalidProfile) => {
            return refused(page, provider_name, StatusCode::BAD_GATEWAY, FAILED);
        }
        Err(AccountError::MissingAccount) => {
            eprintln!("{provider_name} identity is linked to a missing account");
            return refused(page, provider_name, StatusCode::SERVICE_UNAVAILABLE, UNAVAILABLE);
        }
        Err(AccountError::Storage(error)) => {
            eprintln!("{provider_name} account lookup failed: {error}");
            return refused(page, provider_name, StatusCode::SERVICE_UNAVAILABLE, UNAVAILABLE);
        }
    };
    // __RULLST_MFA_SECOND_STEP__
    let session = match session_cookie(&user).await {
        Ok(session) => session,
        Err(error) => {
            eprintln!("Session creation failed: {error}");
            return refused(page, provider_name, StatusCode::FORBIDDEN, SESSION_ERROR);
        }
    };
    let target = return_to
        .as_ref()
        .map_or(DEFAULT_RETURN_PATH, ReturnPath::as_str);
    let mut cookies = vec![session];
    if let Ok(cookie) = challenge_cookie(provider_name) {
        cookies.push(cookie.clear());
    }
    redirect_with_cookies(target, &cookies)
}

/// The provider's display name, else the email's local part: one line of
/// at most 120 characters.
fn display_name(profile: &ConnectUser, email: &str) -> String {
    let name = profile.name.split_whitespace().collect::<Vec<_>>().join(" ");
    let name = if name.is_empty() {
        email.split('@').next().unwrap_or_default().to_owned()
    } else {
        name
    };
    name.chars()
        .filter(|character| !character.is_control())
        .take(120)
        .collect()
}
