#[derive(Debug, Clone, rullst::orm::Orm)]
#[orm(table = "subscriptions", backend = "turso")]
pub struct Subscription {
    pub id: i64,
    pub __FOREIGN_KEY__: i64,
    pub customer_id: String,
    pub subscription_id: String,
    pub plan_id: String,
    pub status: String,
    pub ends_at: Option<i64>,
    pub created_at: String,
    pub updated_at: String,
}

impl Subscription {
    pub async fn find_by_subscription_id(
        subscription_id: &str,
    ) -> Result<Option<Self>, rullst::orm::polyglot::PolyglotError> {
        let subscription_id = subscription_id.to_string();
        Self::query()?
            .where_eq("subscription_id", &subscription_id)?
            .first()
            .await
    }
}
