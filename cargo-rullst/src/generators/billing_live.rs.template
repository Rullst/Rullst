//! Durable Stripe billing. Only authenticated owner IDs enter this module.
use super::{BillingConfig, BillingIdentity, valid_identity};
use rullst::capital::{StripeCheckoutRequest, StripeCustomerRequest, StripeProvider, StripeSubscriptionLookup};
use rullst::server::{IntoResponse, Redirect, Response, StatusCode};
use serde::{Deserialize, Serialize};
#[path = "billing_store.rs"]
mod store;
#[path = "billing_events.rs"]
mod events;
pub(super) use events::webhook;

#[path = "billing_gateway.rs"]
mod gateway;
use gateway::Gateway;

type Result<T> = std::result::Result<T, StatusCode>;
const UNAVAILABLE: StatusCode = StatusCode::SERVICE_UNAVAILABLE;
const CONFLICT: StatusCode = StatusCode::CONFLICT;
const RETRY_WINDOW: i64 = 23 * 3600;

#[derive(Clone, Serialize, Deserialize)]
struct Attempt {
    key: String,
    created: i64,
    price: String,
    success: String,
    cancel: String,
    session: Option<String>,
    subscription: Option<String>,
    closed: bool,
}
#[derive(Clone, Serialize, Deserialize)]
struct Entitlement {
    subscription: String,
    price: String,
    status: String,
    ends_at: Option<i64>,
}
#[derive(Clone, Serialize, Deserialize)]
struct ArchivedAttempt {
    key: String,
    session: Option<String>,
    subscription: Option<String>,
}
#[derive(Clone, Serialize, Deserialize)]
struct State {
    scope: String,
    owner: i64,
    reference: String,
    revision: String,
    customer_key: String,
    customer_started: i64,
    customer: Option<String>,
    attempt: Option<Attempt>,
    previous_attempts: Vec<ArchivedAttempt>,
    entitlement: Option<Entitlement>,
}
struct Receipt { id: String, digest: String }

fn token() -> String { rullst::security::generate_csrf_token() }
fn now() -> Result<i64> {
    std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)
        .map_err(|_| UNAVAILABLE).and_then(|value| i64::try_from(value.as_secs()).map_err(|_| UNAVAILABLE))
}
fn scope(config: &BillingConfig) -> Result<(String, String, bool)> {
    let account = std::env::var("BILLING_ACCOUNT_ID").map_err(|_| UNAVAILABLE)?;
    let mode = if config.api_key.starts_with("sk_test_") || config.api_key.starts_with("rk_test_") { false }
        else if config.api_key.starts_with("sk_live_") || config.api_key.starts_with("rk_live_") { true }
        else { return Err(UNAVAILABLE); };
    if config.provider != "stripe" || !super::strong_webhook_secret(&config.webhook_secret)
        || !account.starts_with("acct_") || !super::valid_plan_id(&account)
        || !config.redirect_url.starts_with("https://")
    { return Err(UNAVAILABLE); }
    Ok((format!("{account}:{}", if mode { "live" } else { "test" }), account, mode))
}
fn provider(config: &BillingConfig) -> StripeProvider {
    StripeProvider::new(config.api_key.clone(), config.webhook_secret.clone())
}
fn customer_request(state: &State) -> Result<StripeCustomerRequest> {
    // No mutable contact data participates in immutable customer provisioning.
    StripeCustomerRequest::new(&state.reference, &state.customer_key).map_err(|_| UNAVAILABLE)
}
fn checkout_request(state: &State) -> Result<StripeCheckoutRequest> {
    let attempt = state.attempt.as_ref().ok_or(CONFLICT)?;
    StripeCheckoutRequest::new(state.customer.as_deref().ok_or(CONFLICT)?, &attempt.price,
        &state.reference, &attempt.key, &attempt.success, &attempt.cancel).map_err(|_| UNAVAILABLE)
}
impl State {
    fn encode(&self) -> Result<String> {
        let text = serde_json::to_string(self).map_err(|_| UNAVAILABLE)?;
        if text.len() > 64 * 1024 { return Err(UNAVAILABLE); }
        Ok(text)
    }
    fn decode(text: &str) -> Result<Self> {
        if text.len() > 64 * 1024 { return Err(UNAVAILABLE); }
        serde_json::from_str(text).map_err(|_| UNAVAILABLE)
    }
}

/// Revision fencing starts BEFORE provider reads, so a late earlier read cannot
/// overwrite a newer reconciliation. A lost response is retried from durable state.
async fn fence(state: &State) -> Result<State> {
    let mut next = state.clone(); next.revision = token();
    if !store::commit(state, &next, None).await? { return Err(UNAVAILABLE); }
    Ok(next)
}
async fn commit(old: &State, mut next: State, receipt: Option<&Receipt>) -> Result<State> {
    next.revision = token();
    if !store::commit(old, &next, receipt).await? { return Err(UNAVAILABLE); }
    Ok(next)
}

pub(super) async fn checkout(config: &BillingConfig, identity: &BillingIdentity, plan: &str) -> Response {
    match checkout_inner(config, identity, plan).await {
        Ok(url) => Redirect::to(&url).into_response(),
        Err(status) => (status, "Checkout could not be completed. Retry to resume your existing attempt.").into_response(),
    }
}
async fn checkout_inner(config: &BillingConfig, identity: &BillingIdentity, plan: &str) -> Result<String> {
    checkout_with(config, identity, plan, &provider(config)).await
}
async fn checkout_with(config: &BillingConfig, identity: &BillingIdentity, plan: &str, provider: &impl Gateway) -> Result<String> {
    if !valid_identity(identity) { return Err(StatusCode::UNAUTHORIZED); }
    if !config.allowed_plan_ids.contains(plan) { return Err(StatusCode::BAD_REQUEST); }
    let (namespace, account, mode) = scope(config)?;
    provider.verify_account(&account, mode).await.map_err(|_| UNAVAILABLE)?;
    let owner = __OWNER_TO_I64__;
    let mut state = match store::owner(&namespace, owner).await? {
        Some(state) => state,
        None => {
            let state = State { scope: namespace.clone(), owner, reference: token(), revision: token(),
                customer_key: token(), customer_started: now()?, customer: None, attempt: None,
                previous_attempts: Vec::new(), entitlement: None };
            // Concurrent first requests share the winning durable intent.
            store::insert(&state).await?;
            store::owner(&namespace, owner).await?.ok_or(UNAVAILABLE)?
        }
    };
    if state.customer.is_none() {
        let request = customer_request(&state)?;
        let age = now()?.saturating_sub(state.customer_started);
        let receipt = if (0..RETRY_WINDOW).contains(&age) {
            provider.create_customer(&request).await.map_err(|_| UNAVAILABLE)?
        } else {
            provider.find_bound_customer(&request).await.map_err(|_| UNAVAILABLE)?.ok_or(UNAVAILABLE)?
        };
        if receipt.livemode() != Some(mode) { return Err(UNAVAILABLE); }
        let mut next = state.clone(); next.customer = Some(receipt.id().into());
        state = commit(&state, next, None).await?;
    }
    if state.entitlement.as_ref().is_some_and(|entitlement| !matches!(entitlement.status.as_str(), "canceled" | "incomplete_expired")) {
        return Err(CONFLICT); // Manage the existing subscription through the portal.
    }
    if state.attempt.as_ref().is_some_and(|attempt| attempt.closed) {
        if state.previous_attempts.len() >= 64 { return Err(UNAVAILABLE); }
        let mut next = state.clone();
        if let Some(attempt) = next.attempt.as_ref() {
            next.previous_attempts.push(ArchivedAttempt { key: attempt.key.clone(), session: attempt.session.clone(), subscription: attempt.subscription.clone() });
        }
        next.attempt = None;
        state = commit(&state, next, None).await?;
    }
    if state.attempt.is_none() {
        let mut next = state.clone();
        next.attempt = Some(Attempt { key: token(), created: now()?, price: plan.into(),
            success: config.redirect_url.clone(), cancel: config.redirect_url.clone(),
            session: None, subscription: None, closed: false });
        state = commit(&state, next, None).await?;
    }
    let attempt = state.attempt.as_ref().ok_or(CONFLICT)?;
    if attempt.price != plan { return Err(CONFLICT); }
    let request = checkout_request(&state)?;
    if let Some(id) = attempt.session.clone() {
        state = fence(&state).await?;
        let snapshot = provider.retrieve_checkout(&request, &id, mode).await.map_err(|_| UNAVAILABLE)?;
        let url = snapshot.url().map(str::to_owned);
        state = reconcile_checkout(config, provider, mode, &state, snapshot).await?;
        // Save reconciliation before redirect. A complete session grants no access by itself.
        if let Some(url) = url { return Ok(url); }
        let _ = state;
        return Err(CONFLICT);
    }
    let age = now()?.saturating_sub(attempt.created);
    if !(0..RETRY_WINDOW).contains(&age) {
        let created = attempt.created;
        state = fence(&state).await?;
        let snapshot = provider.find_checkout(&request, created, None, mode).await
            .map_err(|_| UNAVAILABLE)?.ok_or(UNAVAILABLE)?;
        let url = snapshot.url().map(str::to_owned);
        reconcile_checkout(config, provider, mode, &state, snapshot).await?;
        return url.ok_or(CONFLICT);
    }
    let receipt = provider.create_subscription_checkout(&request).await.map_err(|_| UNAVAILABLE)?;
    if receipt.livemode() != Some(mode) || receipt.request_digest() != request.request_digest() {
        return Err(UNAVAILABLE);
    }
    let mut next = state.clone();
    next.attempt.as_mut().ok_or(CONFLICT)?.session = Some(receipt.id().into());
    commit(&state, next, None).await?;
    Ok(receipt.url().into())
}

async fn reconcile_checkout(config: &BillingConfig, provider: &impl Gateway, mode: bool, state: &State,
    snapshot: gateway::Checkout) -> Result<State>
{
    let mut next = state.clone();
    apply_checkout(&mut next, &snapshot)?;
    refresh_subscription(config, provider, mode, &mut next).await?;
    commit(state, next, None).await
}
fn apply_checkout(state: &mut State, snapshot: &gateway::Checkout) -> Result<()> {
    let attempt = state.attempt.as_mut().ok_or(CONFLICT)?;
    if attempt.session.as_deref().is_some_and(|known| known != snapshot.id())
        || attempt.subscription.as_deref().is_some_and(|known| snapshot.subscription_id() != Some(known))
    { return Err(CONFLICT); }
    attempt.session = Some(snapshot.id().into());
    attempt.subscription = snapshot.subscription_id().map(str::to_owned);
    attempt.closed = snapshot.status() == "expired";
    Ok(())
}
async fn refresh_subscription(config: &BillingConfig, provider: &impl Gateway, mode: bool, state: &mut State) -> Result<()> {
    let attempt = state.attempt.as_ref().ok_or(CONFLICT)?;
    let Some(id) = &attempt.subscription else { return Ok(()); };
    let lookup = StripeSubscriptionLookup::new(id, state.customer.as_deref().ok_or(CONFLICT)?,
        &state.reference, &attempt.price, mode).map_err(|_| UNAVAILABLE)?;
    let snapshot = provider.retrieve_subscription(&lookup, &config.allowed_plan_ids).await.map_err(|_| UNAVAILABLE)?;
    let subscription = snapshot.subscription();
    state.entitlement = Some(Entitlement { subscription: subscription.subscription_id.clone(),
        price: subscription.plan_id.clone(), status: snapshot.provider_status().into(), ends_at: subscription.ends_at });
    if matches!(snapshot.provider_status(), "canceled" | "incomplete_expired") {
        state.attempt.as_mut().ok_or(CONFLICT)?.closed = true;
    }
    Ok(())
}

pub(super) async fn portal(config: &BillingConfig, identity: &BillingIdentity) -> Response {
    async fn run(config: &BillingConfig, identity: &BillingIdentity) -> Result<String> {
        if !valid_identity(identity) { return Err(StatusCode::UNAUTHORIZED); }
        let (namespace, account, mode) = scope(config)?;
        let provider = provider(config);
        provider.verify_account(&account, mode).await.map_err(|_| UNAVAILABLE)?;
        let state = store::owner(&namespace, __OWNER_TO_I64__).await?.ok_or(CONFLICT)?;
        provider.create_bound_customer_portal(state.customer.as_deref().ok_or(CONFLICT)?, &config.redirect_url)
            .await.map_err(|_| UNAVAILABLE)
    }
    match run(config, identity).await {
        Ok(url) => Redirect::to(&url).into_response(),
        Err(status) => status.into_response(),
    }
}

/// Operator recovery when metadata search is unavailable or inconclusive.
/// This function is not mounted as a public route. The caller supplies an
/// authenticated/authorized identity and an independently located provider ID.
pub(super) async fn recover_customer(config: &BillingConfig, identity: &BillingIdentity, customer: &str) -> Result<()> {
    if !valid_identity(identity) { return Err(StatusCode::UNAUTHORIZED); }
    let (namespace, account, mode) = scope(config)?;
    let provider = provider(config);
    provider.verify_account(&account, mode).await.map_err(|_| UNAVAILABLE)?;
    let state = store::owner(&namespace, __OWNER_TO_I64__).await?.ok_or(CONFLICT)?;
    if state.customer.as_deref().is_some_and(|known| known != customer) { return Err(CONFLICT); }
    let request = customer_request(&state)?;
    let receipt = provider.retrieve_bound_customer(&request, customer).await.map_err(|_| UNAVAILABLE)?;
    if receipt.livemode() != Some(mode) || receipt.request_digest() != request.request_digest() { return Err(CONFLICT); }
    let mut next = state.clone(); next.customer = Some(receipt.id().into());
    commit(&state, next, None).await?;
    Ok(())
}
