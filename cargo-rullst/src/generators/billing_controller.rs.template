#[derive(Debug, Clone)]
pub struct BillingIdentity {
    /// Authenticated owner ID, derived from a session plus tenant membership.
    pub owner_id: __OWNER_ID_TYPE__,
    /// Normalized email belonging to that authenticated owner.
    pub email: String,
}

#[derive(Deserialize)]
pub struct CheckoutForm {
    pub plan: String,
}

struct BillingConfig {
    provider: String,
    api_key: String,
    webhook_secret: String,
    redirect_url: String,
    store_id: Option<String>,
    allowed_plan_ids: HashSet<String>,
}

#[derive(Debug)]
pub struct BillingConfigError(&'static str);

impl fmt::Display for BillingConfigError {
    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        formatter.write_str(self.0)
    }
}

impl std::error::Error for BillingConfigError {}

fn is_production() -> bool {
    std::env::var("RULLST_ENV")
        .or_else(|_| std::env::var("APP_ENV"))
        .is_ok_and(|value| matches!(value.trim().to_ascii_lowercase().as_str(), "prod" | "production"))
}

fn is_mock_credential(value: &str) -> bool {
    value
        .get(..5)
        .is_some_and(|prefix| prefix.eq_ignore_ascii_case("mock_"))
}

fn strong_webhook_secret(secret: &str) -> bool {
    secret.len() >= 32
        && secret.bytes().collect::<HashSet<_>>().len() >= 12
        && !is_mock_credential(secret)
}

fn valid_plan_id(plan_id: &str) -> bool {
    !plan_id.is_empty()
        && plan_id.len() <= 200
        && plan_id
            .bytes()
            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-' | b'.'))
}

fn billing_config() -> Result<BillingConfig, BillingConfigError> {
    let provider = std::env::var("BILLING_PROVIDER")
        .unwrap_or_else(|_| "stripe".to_string())
        .trim()
        .to_ascii_lowercase();
    if !matches!(provider.as_str(), "stripe" | "lemonsqueezy") {
        return Err(BillingConfigError(
            "BILLING_PROVIDER must be stripe or lemonsqueezy",
        ));
    }
    let api_key = std::env::var("BILLING_API_KEY").unwrap_or_default();
    let webhook_secret = std::env::var("BILLING_WEBHOOK_SECRET").unwrap_or_default();
    let store_id = std::env::var("BILLING_STORE_ID")
        .ok()
        .filter(|value| !value.is_empty());
    if provider == "lemonsqueezy" && !api_key.is_empty() && !api_key.starts_with("mock_")
        && !store_id.as_deref().is_some_and(|value| {
            value.parse::<u64>().is_ok_and(|id| id > 0 && id.to_string() == value)
        })
    {
        return Err(BillingConfigError(
            "live Lemon Squeezy billing requires a positive numeric BILLING_STORE_ID",
        ));
    }
    let redirect_url = std::env::var("BILLING_REDIRECT_URL")
        .unwrap_or_else(|_| "http://localhost:3000/dashboard".to_string());
    let configured_plans = std::env::var("BILLING_ALLOWED_PLAN_IDS").ok();
    let allowed_plan_ids = configured_plans
        .as_deref()
        .unwrap_or("price_starter,price_pro")
        .split(',')
        .map(str::trim)
        .filter(|plan_id| !plan_id.is_empty())
        .map(str::to_string)
        .collect::<HashSet<_>>();
    if allowed_plan_ids.is_empty()
        || allowed_plan_ids.len() > 64
        || allowed_plan_ids.iter().any(|plan_id| !valid_plan_id(plan_id))
    {
        return Err(BillingConfigError(
            "BILLING_ALLOWED_PLAN_IDS must contain 1 to 64 comma-separated provider plan IDs",
        ));
    }

    if is_production()
        && (api_key.trim().is_empty()
            || is_mock_credential(&api_key)
            || !strong_webhook_secret(&webhook_secret)
            || !redirect_url.starts_with("https://")
            || configured_plans.is_none())
    {
        return Err(BillingConfigError(
            "production billing requires real credentials, a strong webhook secret, an HTTPS redirect URL, and an explicit plan allowlist",
        ));
    }

    Ok(BillingConfig {
        provider,
        api_key,
        webhook_secret,
        redirect_url,
        store_id,
        allowed_plan_ids,
    })
}

fn lemon_provider(config: &BillingConfig) -> Result<LemonSqueezyProvider, rullst::capital::CapitalError> {
    let provider = LemonSqueezyProvider::new(config.api_key.clone(), config.webhook_secret.clone());
    match &config.store_id {
        Some(store_id) => provider.with_store_id(store_id),
        None => Ok(provider),
    }
}

// Email-based mock fixtures are isolated from the durable Stripe implementation.
// Mixed credentials and unsupported live providers fail closed in live::scope.
fn local_billing_fixture(config: &BillingConfig) -> bool {
    !is_production()
        && (config.api_key.is_empty() || config.api_key.starts_with("mock_"))
        && (config.webhook_secret.is_empty() || config.webhook_secret.starts_with("mock_"))
}

/// Configures the provider used by the mandatory signed-webhook middleware.
pub fn initialize_billing_provider() -> Result<(), BillingConfigError> {
    let config = billing_config()?;
    let provider: Box<dyn BillingProvider> = match config.provider.as_str() {
        "lemonsqueezy" => Box::new(lemon_provider(&config)
            .map_err(|_| BillingConfigError("invalid Lemon Squeezy store configuration"))?),
        _ => Box::new(StripeProvider::new(config.api_key, config.webhook_secret)),
    };
    rullst::capital::init_provider(provider);
    Ok(())
}

/// Initializes billing fail-closed before delegating to signature, freshness,
/// payload and replay verification in rullst-capital.
pub async fn verify_billing_webhook(
    request: Request,
    next: Next,
) -> Result<Response, StatusCode> {
    let config = billing_config().map_err(|_| StatusCode::SERVICE_UNAVAILABLE)?;
    if !local_billing_fixture(&config) {
        return live::webhook(&config, request).await;
    }
    if let Err(error) = initialize_billing_provider() {
        eprintln!("Billing webhook configuration error: {error}");
        return Err(StatusCode::INTERNAL_SERVER_ERROR);
    }
    rullst::capital::verify_webhook(request, next).await
}

fn normalize_email(email: &str) -> String {
    email.trim().to_ascii_lowercase()
}

fn valid_identity(identity: &BillingIdentity) -> bool {
    identity.owner_id > 0
        && identity.email.len() <= 254
        && identity.email.split_once('@').is_some_and(|(local, domain)| {
            !local.is_empty() && domain.contains('.') && !domain.ends_with('.')
        })
}

async fn billing_customer(
    identity: &BillingIdentity,
) -> Result<BillingCustomer, (StatusCode, String)> {
    if !valid_identity(identity) {
        return Err((StatusCode::UNAUTHORIZED, "Invalid billing identity".to_string()));
    }
    let email = normalize_email(&identity.email);
    match BillingCustomer::find_by_email(&email).await {
        Ok(Some(customer)) if customer.__FOREIGN_KEY__ != identity.owner_id => Err((
            StatusCode::FORBIDDEN,
            "Billing identity does not own this customer".to_string(),
        )),
        Ok(Some(customer)) => Ok(customer),
        Ok(None) => {
            let mut customer = BillingCustomer {
                id: 0,
                __FOREIGN_KEY__: identity.owner_id,
                email,
                customer_id: None,
                created_at: String::new(),
                updated_at: String::new(),
            };
            customer.save().await.map_err(|error| {
                (
                    StatusCode::INTERNAL_SERVER_ERROR,
                    format!("Failed to persist billing identity: {error}"),
                )
            })?;
            Ok(customer)
        }
        Err(error) => Err((
            StatusCode::INTERNAL_SERVER_ERROR,
            format!("Failed to query billing identity: {error}"),
        )),
    }
}

pub async fn pricing_view(
    csrf: Option<Extension<rullst::security::CsrfToken>>,
    csp_nonce: Option<Extension<rullst::security::CspNonce>>,
) -> impl IntoResponse {
    let csrf_token = csrf
        .as_ref()
        .map(|Extension(token)| token.as_str())
        .unwrap_or_default();
    let nonce = csp_nonce
        .as_ref()
        .map(|Extension(nonce)| nonce.as_str())
        .unwrap_or_default();
    billing::pricing_page(csrf_token, nonce)
}

pub async fn checkout_redirect(
    Extension(identity): Extension<BillingIdentity>,
    Form(form): Form<CheckoutForm>,
) -> Response {
    if !valid_plan_id(&form.plan) {
        return (StatusCode::BAD_REQUEST, "Invalid plan").into_response();
    }
    let config = match billing_config() {
        Ok(config) => config,
        Err(error) => {
            return (StatusCode::SERVICE_UNAVAILABLE, error.to_string()).into_response();
        }
    };
    if !config.allowed_plan_ids.contains(&form.plan) {
        return (StatusCode::BAD_REQUEST, "Plan is not enabled").into_response();
    }
    if !local_billing_fixture(&config) {
        return live::checkout(&config, &identity, &form.plan).await;
    }
    let customer = match billing_customer(&identity).await {
        Ok(customer) => customer,
        Err(error) => return error.into_response(),
    };

    let result = match config.provider.as_str() {
        "lemonsqueezy" => match lemon_provider(&config) {
            Ok(provider) => provider
                .create_checkout_session(&customer.email, &form.plan, &config.redirect_url)
                .await,
            Err(error) => Err(error),
        },
        _ => {
            StripeProvider::new(config.api_key, config.webhook_secret)
                .create_checkout_session(&customer.email, &form.plan, &config.redirect_url)
                .await
        }
    };
    match result {
        Ok(url) => Redirect::to(&url).into_response(),
        Err(error) => {
            eprintln!("Checkout creation failed: {error}");
            StatusCode::BAD_GATEWAY.into_response()
        }
    }
}

pub async fn portal_redirect(Extension(identity): Extension<BillingIdentity>) -> Response {
    let config = match billing_config() {
        Ok(config) => config,
        Err(error) => {
            return (StatusCode::SERVICE_UNAVAILABLE, error.to_string()).into_response();
        }
    };
    if !local_billing_fixture(&config) {
        return live::portal(&config, &identity).await;
    }
    let customer = match billing_customer(&identity).await {
        Ok(customer) => customer,
        Err(error) => return error.into_response(),
    };

    let result = match config.provider.as_str() {
        "lemonsqueezy" => {
            LemonSqueezyProvider::new(config.api_key, config.webhook_secret)
                .create_customer_portal(&customer.email, &config.redirect_url)
                .await
        }
        _ => {
            StripeProvider::new(config.api_key, config.webhook_secret)
                .create_customer_portal(&customer.email, &config.redirect_url)
                .await
        }
    };
    match result {
        Ok(url) => Redirect::to(&url).into_response(),
        Err(error) => {
            eprintln!("Customer portal creation failed: {error}");
            StatusCode::BAD_GATEWAY.into_response()
        }
    }
}

/// Accepts only events inserted by rullst-capital's mandatory signature/replay middleware.
pub async fn webhook_handler(Extension(event): Extension<WebhookEvent>) -> Response {
    let email = normalize_email(&event.customer_email);
    if event.customer_id.trim().is_empty()
        || event.subscription_id.trim().is_empty()
        || event.plan_id.trim().is_empty()
        || email.len() > 254
        || !email.split_once('@').is_some_and(|(local, domain)| {
            !local.is_empty() && domain.contains('.') && !domain.ends_with('.')
        })
    {
        return StatusCode::UNPROCESSABLE_ENTITY.into_response();
    }
    let config = match billing_config() {
        Ok(config) => config,
        Err(error) => {
            eprintln!("Billing webhook configuration error: {error}");
            return StatusCode::SERVICE_UNAVAILABLE.into_response();
        }
    };
    if !config.allowed_plan_ids.contains(&event.plan_id) {
        return StatusCode::UNPROCESSABLE_ENTITY.into_response();
    }
    if !local_billing_fixture(&config) {
        return StatusCode::SERVICE_UNAVAILABLE.into_response();
    }

    let mut customer = match BillingCustomer::find_by_email(&email).await {
        Ok(Some(customer)) => customer,
        Ok(None) => return StatusCode::CONFLICT.into_response(),
        Err(error) => {
            eprintln!("Billing customer lookup failed: {error}");
            return StatusCode::INTERNAL_SERVER_ERROR.into_response();
        }
    };
    if customer
        .customer_id
        .as_deref()
        .is_some_and(|known| known != event.customer_id)
    {
        return StatusCode::CONFLICT.into_response();
    }
    let existing = Subscription::find_by_subscription_id(&event.subscription_id).await;
    let mut subscription = match existing {
        Ok(Some(subscription)) if subscription.__FOREIGN_KEY__ != customer.__FOREIGN_KEY__ => {
            return StatusCode::FORBIDDEN.into_response();
        }
        Ok(Some(subscription)) if subscription.customer_id != event.customer_id => {
            return StatusCode::CONFLICT.into_response();
        }
        Ok(Some(subscription)) => subscription,
        Ok(None) => Subscription {
            id: 0,
            __FOREIGN_KEY__: customer.__FOREIGN_KEY__,
            customer_id: event.customer_id.clone(),
            subscription_id: event.subscription_id.clone(),
            plan_id: event.plan_id.clone(),
            status: event.status.as_str().to_string(),
            ends_at: event.ends_at,
            created_at: String::new(),
            updated_at: String::new(),
        },
        Err(error) => {
            eprintln!("Subscription lookup failed: {error}");
            return StatusCode::INTERNAL_SERVER_ERROR.into_response();
        }
    };

    if customer.customer_id.is_none() {
        customer.customer_id = Some(event.customer_id.clone());
    }

    subscription.customer_id = event.customer_id;
    subscription.plan_id = event.plan_id;
    subscription.status = event.status.as_str().to_string();
    subscription.ends_at = event.ends_at;
    if let Err(error) = persist_billing_update(&customer, &subscription).await {
        eprintln!("Billing transaction failed: {error}");
        return StatusCode::INTERNAL_SERVER_ERROR.into_response();
    }

    StatusCode::OK.into_response()
}

__PERSIST_BILLING_UPDATE__

/// Explicit server-side operator recovery; never mounted automatically. Resolve
/// and authorize the local owner before supplying the independently found ID.
pub async fn recover_stripe_customer(identity: &BillingIdentity, customer_id: &str) -> Result<(), StatusCode> {
    let config = billing_config().map_err(|_| StatusCode::SERVICE_UNAVAILABLE)?;
    live::recover_customer(&config, identity, customer_id).await
}
