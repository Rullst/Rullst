//! Two-step verification with an authenticator app (RFC 6238 TOTP),
//! generated by `cargo rullst make:mfa`.
//!
//! Routes (mount every one inside the CSRF layer):
//!
//! - `GET /account/security`, `POST /account/security/mfa/setup`,
//!   `/account/security/mfa/confirm` and `/account/security/mfa/disable`:
//!   behind the sign-in middleware, which inserts the account id as
//!   `Extension<i32>`; put the credential rate limit on confirm and disable.
//! - `GET` and `POST /login/mfa`: the second sign-in step, without the
//!   sign-in middleware (the challenge cookie names the account); put the
//!   credential rate limit on the POST.
//!
//! The sign-in handlers call [`second_step`] after the password (and after
//! a provider sign-in): an account with a confirmed factor then gets a
//! five-minute challenge instead of a session. Turning the factor on signs
//! out every other session, through the account's session epoch. A lost
//! phone is reset from the server with `admin:mfa-reset <email>` ([`admin`]).
mod account;
pub mod admin;
mod challenge;
mod factor;

pub use challenge::second_step;
pub use factor::{MfaError, is_enrolled, remove_factor, verify_second_factor};

use crate::pages::mfa::{self as pages, SecurityView};
use rullst::security::{CspNonce, CsrfToken};
use rullst::server::{
    Extension, Form, HeaderMap, HeaderValue, IntoResponse, Query, Redirect, Response, StatusCode,
    header,
};
use serde::Deserialize;

/// The sign-in page, where a second step that cannot go on starts again.
const SIGN_IN_PATH: &str = "/login";
const SECURITY_PATH: &str = "/account/security";
const EXPIRED: &str = "This sign-in expired or was already used. Sign in again.";
const ENABLED: &str = "Two-step verification is on. Your other devices were signed out.";
const DISABLED: &str = "Two-step verification is off.";
const SESSIONS_NOT_ENDED: &str = "Two-step verification is on, but your other devices could not be signed out. Sign out everywhere to end them.";

#[derive(Deserialize)]
pub struct MfaCodeForm {
    #[serde(default)]
    pub code: String,
}

#[derive(Deserialize)]
pub struct SecurityQuery {
    pub done: Option<String>,
}

fn token(csrf: &Option<Extension<CsrfToken>>) -> &str {
    csrf.as_ref()
        .map(|Extension(token)| token.as_str())
        .unwrap_or_default()
}

fn nonce(nonce: &Option<Extension<CspNonce>>) -> &str {
    nonce
        .as_ref()
        .map(|Extension(nonce)| nonce.as_str())
        .unwrap_or_default()
}

/// These pages show keys or carry one-time state: never cached.
fn private(response: impl IntoResponse) -> Response {
    let mut response = response.into_response();
    response
        .headers_mut()
        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
    response
}

fn status_of(error: MfaError) -> StatusCode {
    match error {
        MfaError::AlreadyEnrolled => StatusCode::CONFLICT,
        MfaError::NotEnrolled | MfaError::InvalidCode => StatusCode::UNPROCESSABLE_ENTITY,
        MfaError::TooManyAttempts => StatusCode::TOO_MANY_REQUESTS,
        MfaError::Unavailable => StatusCode::SERVICE_UNAVAILABLE,
    }
}

fn security_page(status: StatusCode, view: &SecurityView<'_>, csrf: &str, nonce: &str) -> Response {
    private((status, pages::security_page(view, csrf, nonce)))
}

/// The security page with `error` and no pending setup.
fn security_error(error: MfaError, enrolled: bool, csrf: &str, nonce: &str) -> Response {
    let view = SecurityView {
        enrolled,
        setup: None,
        error: Some(error.message()),
        notice: None,
    };
    security_page(status_of(error), &view, csrf, nonce)
}

/// `GET /account/security`.
pub async fn security_view(
    Extension(user_id): Extension<i32>,
    Query(query): Query<SecurityQuery>,
    csrf: Option<Extension<CsrfToken>>,
    csp_nonce: Option<Extension<CspNonce>>,
) -> Response {
    let (csrf, nonce) = (token(&csrf), nonce(&csp_nonce));
    let notice = match query.done.as_deref() {
        Some("enabled") => Some(ENABLED),
        Some("disabled") => Some(DISABLED),
        _ => None,
    };
    match is_enrolled(user_id).await {
        Ok(enrolled) => {
            let view = SecurityView {
                enrolled,
                setup: None,
                error: None,
                notice,
            };
            security_page(StatusCode::OK, &view, csrf, nonce)
        }
        Err(error) => security_error(error, false, csrf, nonce),
    }
}

/// `POST /account/security/mfa/setup`: a new pending factor and its QR code.
pub async fn setup(
    Extension(user_id): Extension<i32>,
    csrf: Option<Extension<CsrfToken>>,
    csp_nonce: Option<Extension<CspNonce>>,
) -> Response {
    let (csrf, nonce) = (token(&csrf), nonce(&csp_nonce));
    let account = match account::find(user_id).await {
        Ok(Some(account)) => account,
        Ok(None) => return Redirect::to(SIGN_IN_PATH).into_response(),
        Err(error) => return security_error(error, false, csrf, nonce),
    };
    match factor::begin_enrollment(&account).await {
        Ok(enrollment) => {
            let view = SecurityView {
                enrolled: false,
                setup: Some((enrollment.qr_svg.as_str(), enrollment.secret.as_str())),
                error: None,
                notice: None,
            };
            security_page(StatusCode::OK, &view, csrf, nonce)
        }
        Err(error) => security_error(error, error == MfaError::AlreadyEnrolled, csrf, nonce),
    }
}

/// `POST /account/security/mfa/confirm`: turns the factor on with a current
/// code, then signs out every other session (none of them passed the new
/// second step) and renews this browser's.
pub async fn confirm(
    Extension(user_id): Extension<i32>,
    csrf: Option<Extension<CsrfToken>>,
    csp_nonce: Option<Extension<CspNonce>>,
    Form(form): Form<MfaCodeForm>,
) -> Response {
    let (csrf, nonce) = (token(&csrf), nonce(&csp_nonce));
    if let Err(error) = factor::confirm_enrollment(user_id, &form.code).await {
        // The same pending setup again, so the code can be retried.
        let pending = match account::find(user_id).await {
            Ok(Some(account)) => factor::pending_enrollment(&account).await.ok().flatten(),
            _ => None,
        };
        let view = SecurityView {
            enrolled: false,
            setup: pending
                .as_ref()
                .map(|setup| (setup.qr_svg.as_str(), setup.secret.as_str())),
            error: Some(error.message()),
            notice: None,
        };
        return security_page(status_of(error), &view, csrf, nonce);
    }
    if account::end_sessions(user_id).await.is_err() {
        let view = SecurityView {
            enrolled: true,
            setup: None,
            error: Some(SESSIONS_NOT_ENDED),
            notice: None,
        };
        return security_page(StatusCode::SERVICE_UNAVAILABLE, &view, csrf, nonce);
    }
    match account::sign_in_cookie(user_id).await {
        Ok(session) => {
            challenge::redirect_with_cookies(&format!("{SECURITY_PATH}?done=enabled"), &[session])
        }
        // This session ended with the others: sign in again, with the code.
        Err(_) => Redirect::to(SIGN_IN_PATH).into_response(),
    }
}

/// `POST /account/security/mfa/disable`: needs a current code, not only the
/// session.
pub async fn disable(
    Extension(user_id): Extension<i32>,
    csrf: Option<Extension<CsrfToken>>,
    csp_nonce: Option<Extension<CspNonce>>,
    Form(form): Form<MfaCodeForm>,
) -> Response {
    let (csrf, nonce) = (token(&csrf), nonce(&csp_nonce));
    let removed = match verify_second_factor(user_id, &form.code).await {
        Ok(()) => remove_factor(user_id).await,
        Err(error) => Err(error),
    };
    match removed {
        Ok(()) => Redirect::to(&format!("{SECURITY_PATH}?done=disabled")).into_response(),
        Err(error) => security_error(error, error != MfaError::NotEnrolled, csrf, nonce),
    }
}

/// The second step cannot go on: a page that says why and clears the cookie.
fn restart(status: StatusCode, message: &str, nonce: &str) -> Response {
    let mut response = private((status, pages::restart_page(message, nonce)));
    if let Ok(value) = HeaderValue::from_str(&challenge::clear_cookie()) {
        response.headers_mut().append(header::SET_COOKIE, value);
    }
    response
}

/// `GET /login/mfa`: asks for the code of a live challenge.
pub async fn challenge_view(
    headers: HeaderMap,
    csrf: Option<Extension<CsrfToken>>,
    csp_nonce: Option<Extension<CspNonce>>,
) -> Response {
    let (csrf, nonce) = (token(&csrf), nonce(&csp_nonce));
    match challenge::open(&headers).await {
        Ok(Some(_)) => private(pages::code_page(csrf, nonce, None)),
        Ok(None) => restart(StatusCode::BAD_REQUEST, EXPIRED, nonce),
        Err(error) => restart(status_of(error), error.message(), nonce),
    }
}

/// `POST /login/mfa`: checks the code and issues the session. Each
/// challenge accepts `MAX_ATTEMPTS` codes and signs in once.
pub async fn challenge_submit(
    headers: HeaderMap,
    csrf: Option<Extension<CsrfToken>>,
    csp_nonce: Option<Extension<CspNonce>>,
    Form(form): Form<MfaCodeForm>,
) -> Response {
    let (csrf, nonce) = (token(&csrf), nonce(&csp_nonce));
    let challenge = match challenge::open(&headers).await {
        Ok(Some(challenge)) => challenge,
        Ok(None) => return restart(StatusCode::BAD_REQUEST, EXPIRED, nonce),
        Err(error) => return restart(status_of(error), error.message(), nonce),
    };
    match challenge::count_attempt(&challenge).await {
        Ok(true) => {}
        Ok(false) => {
            let error = MfaError::TooManyAttempts;
            return restart(status_of(error), error.message(), nonce);
        }
        Err(error) => return restart(status_of(error), error.message(), nonce),
    }
    match verify_second_factor(challenge.account_id, &form.code).await {
        Ok(()) => {}
        Err(MfaError::InvalidCode) if challenge.attempts + 1 < challenge::MAX_ATTEMPTS => {
            let error = MfaError::InvalidCode;
            return private((
                status_of(error),
                pages::code_page(csrf, nonce, Some(error.message())),
            ));
        }
        Err(MfaError::InvalidCode) => {
            let error = MfaError::TooManyAttempts;
            return restart(status_of(error), error.message(), nonce);
        }
        // The factor was reset meanwhile: the password step starts again.
        Err(MfaError::NotEnrolled) => return restart(StatusCode::BAD_REQUEST, EXPIRED, nonce),
        Err(error) => return restart(status_of(error), error.message(), nonce),
    }
    // One use: only the request that deletes the challenge signs in.
    match challenge::take(&challenge).await {
        Ok(true) => {}
        Ok(false) => return restart(StatusCode::BAD_REQUEST, EXPIRED, nonce),
        Err(error) => return restart(status_of(error), error.message(), nonce),
    }
    match account::sign_in_cookie(challenge.account_id).await {
        Ok(session) => challenge::redirect_with_cookies(
            challenge::safe_target(&challenge.target),
            &[session, challenge::clear_cookie()],
        ),
        Err(error) => restart(status_of(error), error.message(), nonce),
    }
}
