// Generated by cargo rullst make:mfa — server-side TOTP second factor.
//
// Every handler takes the signed-in user's id from `Extension<i32>`, which the
// `cargo rullst auth` middleware inserts; without it the request is rejected.
// Mount the routes behind that middleware and the CSRF/rate-limit baseline,
// and require a recent password check before enrollment. TOTP secrets live in
// `user_mfa_factors`: protect that table and its backups like credentials.
use rullst::db::{Orm, sqlx};
use rullst::security_runtime::mfa::{
    MIN_TOTP_SECRET_BYTES, decode_base32, generate_totp_at_counter,
};
use rullst::security_runtime::{build_otpauth_uri, try_generate_mfa_secret};
use rullst::server::{Extension, Form, IntoResponse, Json, Response, StatusCode, header};
use serde::{Deserialize, Serialize};

/// Second-factor failures; none of them carries secret material.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum MfaError {
    /// The account already has a confirmed factor.
    AlreadyEnrolled,
    /// No pending (or confirmed) factor exists for the account.
    NotEnrolled,
    /// The code is malformed, wrong, expired or was already used.
    InvalidCode,
    /// Storage or randomness failed; nothing was accepted.
    Unavailable,
}

#[derive(Serialize)]
pub struct MfaEnrollment {
    pub secret: String,
    pub otpauth_url: String,
}

#[derive(Deserialize)]
pub struct MfaCodeForm {
    pub code: String,
}

fn dialect(sql: &str) -> Result<String, MfaError> {
    Ok(if Orm::driver().map_err(|_| MfaError::Unavailable)? == "postgres" {
        rullst::orm::replace_placeholders(sql)
    } else {
        sql.to_owned()
    })
}

fn issuer() -> String {
    std::env::var("MFA_ISSUER")
        .ok()
        .filter(|issuer| !issuer.trim().is_empty())
        .unwrap_or_else(|| "Rullst".to_owned())
}

/// Loads the stored secret and last accepted step for one factor state.
async fn load_factor(owner: i64, confirmed: i32) -> Result<Option<(String, Option<i64>)>, MfaError> {
    let sql = dialect(
        "SELECT secret, last_accepted_step FROM user_mfa_factors WHERE user_id = ? AND confirmed = ?",
    )?;
    sqlx::query_as::<_, (String, Option<i64>)>(sqlx::AssertSqlSafe(sql.as_str()))
        .bind(owner)
        .bind(confirmed)
        .fetch_optional(Orm::pool().map_err(|_| MfaError::Unavailable)?)
        .await
        .map_err(|_| MfaError::Unavailable)
}

/// Returns the oldest step in the current +-1 window that is newer than
/// `last_accepted_step` and whose code equals `code`, compared in constant
/// time, so a code is accepted at most once (RFC 6238 section 5.2).
fn verify_totp_step_after(
    base32_secret: &str,
    code: &str,
    last_accepted_step: Option<u64>,
) -> Option<u64> {
    if code.len() != 6 || !code.bytes().all(|byte| byte.is_ascii_digit()) {
        return None;
    }
    let secret = decode_base32(base32_secret)?;
    if secret.len() < MIN_TOTP_SECRET_BYTES {
        return None;
    }
    let current = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .ok()?
        .as_secs()
        / 30;
    let mut matched = None;
    for step in [current.checked_sub(1), Some(current), current.checked_add(1)]
        .into_iter()
        .flatten()
    {
        let expected = format!("{:06}", generate_totp_at_counter(&secret, step));
        let difference = expected
            .bytes()
            .zip(code.bytes())
            .fold(0_u8, |difference, (left, right)| difference | (left ^ right));
        let newer = last_accepted_step.is_none_or(|last| step > last);
        if difference == 0 && newer && matched.is_none() {
            matched = Some(step);
        }
    }
    matched
}

/// Verifies `code` against the server-side secret, rejecting reused steps.
fn accepted_step(secret: &str, code: &str, last: Option<i64>) -> Result<i64, MfaError> {
    let last = last
        .map(u64::try_from)
        .transpose()
        .map_err(|_| MfaError::Unavailable)?;
    let step = verify_totp_step_after(secret, code.trim(), last).ok_or(MfaError::InvalidCode)?;
    i64::try_from(step).map_err(|_| MfaError::Unavailable)
}

/// Records `step` only when no equal or later step was accepted concurrently.
async fn record_step(sql: &str, step: i64, owner: i64, secret: &str) -> Result<(), MfaError> {
    let sql = dialect(sql)?;
    let changed = sqlx::query(sqlx::AssertSqlSafe(sql.as_str()))
        .bind(step)
        .bind(owner)
        .bind(secret)
        .bind(step)
        .execute(Orm::pool().map_err(|_| MfaError::Unavailable)?)
        .await
        .map_err(|_| MfaError::Unavailable)?
        .rows_affected();
    if changed == 1 { Ok(()) } else { Err(MfaError::InvalidCode) }
}

/// Starts (or restarts) enrollment with a new server-generated secret.
pub async fn begin_enrollment(user_id: i32) -> Result<MfaEnrollment, MfaError> {
    let owner = i64::from(user_id);
    if load_factor(owner, 1).await?.is_some() {
        return Err(MfaError::AlreadyEnrolled);
    }
    let secret = try_generate_mfa_secret().map_err(|_| MfaError::Unavailable)?;
    let delete = dialect("DELETE FROM user_mfa_factors WHERE user_id = ? AND confirmed = 0")?;
    let insert = dialect(
        "INSERT INTO user_mfa_factors (user_id, secret, confirmed, last_accepted_step) VALUES (?, ?, 0, NULL)",
    )?;
    let mut transaction = Orm::begin_transaction()
        .await
        .map_err(|_| MfaError::Unavailable)?;
    let stored = async {
        sqlx::query(sqlx::AssertSqlSafe(delete.as_str()))
            .bind(owner)
            .execute(&mut *transaction)
            .await?;
        sqlx::query(sqlx::AssertSqlSafe(insert.as_str()))
            .bind(owner)
            .bind(secret.as_str())
            .execute(&mut *transaction)
            .await?;
        Ok::<(), sqlx::Error>(())
    }
    .await;
    if stored.is_err() {
        let _ = transaction.rollback().await;
        return Err(MfaError::Unavailable);
    }
    transaction.commit().await.map_err(|_| MfaError::Unavailable)?;
    let otpauth_url = build_otpauth_uri(&issuer(), &format!("user-{user_id}"), &secret);
    Ok(MfaEnrollment { secret, otpauth_url })
}

/// Activates the pending factor with a current code from the authenticator.
pub async fn confirm_enrollment(user_id: i32, code: &str) -> Result<(), MfaError> {
    let owner = i64::from(user_id);
    let (secret, last) = load_factor(owner, 0).await?.ok_or(MfaError::NotEnrolled)?;
    let step = accepted_step(&secret, code, last)?;
    record_step(
        "UPDATE user_mfa_factors SET confirmed = 1, last_accepted_step = ? WHERE user_id = ? AND confirmed = 0 AND secret = ? AND (last_accepted_step IS NULL OR last_accepted_step < ?)",
        step,
        owner,
        &secret,
    )
    .await
}

/// Verifies a code for the confirmed factor; each time step is accepted once.
///
/// To gate login, keep the session pending until this succeeds; the
/// `cargo rullst auth` controller issues a full session after the password.
pub async fn verify_second_factor(user_id: i32, code: &str) -> Result<(), MfaError> {
    let owner = i64::from(user_id);
    let (secret, last) = load_factor(owner, 1).await?.ok_or(MfaError::NotEnrolled)?;
    let step = accepted_step(&secret, code, last)?;
    record_step(
        "UPDATE user_mfa_factors SET last_accepted_step = ? WHERE user_id = ? AND confirmed = 1 AND secret = ? AND (last_accepted_step IS NULL OR last_accepted_step < ?)",
        step,
        owner,
        &secret,
    )
    .await
}

fn failure(error: MfaError) -> Response {
    let (status, message) = match error {
        MfaError::AlreadyEnrolled => (StatusCode::CONFLICT, "A second factor is already enrolled"),
        MfaError::NotEnrolled => (StatusCode::NOT_FOUND, "No matching second-factor enrollment"),
        MfaError::InvalidCode => (StatusCode::UNPROCESSABLE_ENTITY, "Invalid or already used code"),
        MfaError::Unavailable => (StatusCode::SERVICE_UNAVAILABLE, "Second factor unavailable"),
    };
    (status, message).into_response()
}

/// POST /auth/mfa/setup — creates a pending factor for the signed-in account.
pub async fn mfa_setup(Extension(user_id): Extension<i32>) -> Response {
    match begin_enrollment(user_id).await {
        Ok(enrollment) => ([(header::CACHE_CONTROL, "no-store")], Json(enrollment)).into_response(),
        Err(error) => failure(error),
    }
}

/// POST /auth/mfa/confirm — activates the pending factor.
pub async fn mfa_confirm(
    Extension(user_id): Extension<i32>,
    Form(form): Form<MfaCodeForm>,
) -> Response {
    match confirm_enrollment(user_id, &form.code).await {
        Ok(()) => StatusCode::NO_CONTENT.into_response(),
        Err(error) => failure(error),
    }
}

/// POST /auth/mfa/verify — step-up check for the signed-in account.
pub async fn mfa_verify(
    Extension(user_id): Extension<i32>,
    Form(form): Form<MfaCodeForm>,
) -> Response {
    match verify_second_factor(user_id, &form.code).await {
        Ok(()) => StatusCode::NO_CONTENT.into_response(),
        Err(error) => failure(error),
    }
}
