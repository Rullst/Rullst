//! Progressive Web App support generated by `cargo rullst make:pwa`; the
//! application owns this file. PWA.md lists what to change before release.
//!
//! - `/sw.js`: the service worker in `src/pwa/sw.js`, served from the site
//!   root so that it may control every page.
//! - `/offline`: the page the worker shows for a navigation without network.
//! - `/.well-known/assetlinks.json`: for the Google Play package, once configured.
//! - [`head`]: the tags every layout puts in its `<head>`.
//!
//! The manifest, icons and `pwa.js` are files in `static/`.

use rullst::html::Markup;
use rullst::htmx::{HtmxRequest, render_page_with_lang};
use rullst::http::{HeaderValue, header};
use rullst::response::{IntoResponse, Response};

const SERVICE_WORKER: &str = include_str!("pwa/sw.js");

/// The manifest link, the browser theme colour, the iOS home-screen icon and
/// the worker registration. `pwa.js` is a same-origin file, so the default
/// Content-Security-Policy allows it without a nonce.
pub fn head() -> Markup {
    rullst::html! {
        <link rel="manifest" href="/static/manifest.webmanifest" />
        <meta name="theme-color" content="__THEME_COLOR__" />
        <link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png" />
        <script src="/static/pwa.js" defer="defer"></script>
    }
}

/// The routes of the PWA. They answer GET only, so they need no CSRF layer.
///
/// `/.well-known/assetlinks.json` lets the Google Play package of this site
/// open without a browser address bar. It is served once
/// `RULLST_ANDROID_ASSET_LINKS` (environment or `.env`) or
/// `[[android.asset_links]]` in `Rullst.toml` names the app (PWA.md).
pub fn router() -> rullst::Router {
    let routes = rullst::routes![
        get("/sw.js" => service_worker),
        get("/offline" => offline),
    ];
    match rullst::pwa::AssetLinks::from_project() {
        Ok(links) => routes.merge_axum(links.router()),
        Err(error) => {
            eprintln!("/.well-known/assetlinks.json is not served: {error}");
            routes
        }
    }
}

/// The worker, with its cache named after the package version: releasing a
/// new version installs a new worker, and the page offers a reload. Browsers
/// revalidate it on every update check (`no-cache`).
async fn service_worker() -> Response {
    let source = SERVICE_WORKER.replacen(
        "const VERSION = 'dev';",
        concat!("const VERSION = '", env!("CARGO_PKG_VERSION"), "';"),
        1,
    );
    (
        [
            (
                header::CONTENT_TYPE,
                HeaderValue::from_static("text/javascript; charset=utf-8"),
            ),
            (header::CACHE_CONTROL, HeaderValue::from_static("no-cache")),
        ],
        source,
    )
        .into_response()
}

/// It shows no personal data, so it may be stored (`no-cache`): the worker
/// stores nothing marked `no-store`, which Rullst answers by default.
async fn offline(htmx: HtmxRequest) -> Response {
    let content = rullst::html! {
        <main class="flex flex-col items-center justify-center min-h-screen bg-slate-950 text-slate-100 p-6 font-sans text-center">
            <h1 class="text-3xl font-bold">"You are offline"</h1>
            <p class="mt-4 text-slate-400">"This page needs a connection. Check your network and try again."</p>
            <p class="mt-6"><a class="text-sky-400 underline" href="">"Try again"</a></p>
        </main>
    };
    (
        [(header::CACHE_CONTROL, HeaderValue::from_static("no-cache"))],
        render_page_with_lang(&htmx, "__LANG__", "Offline", content),
    )
        .into_response()
}
