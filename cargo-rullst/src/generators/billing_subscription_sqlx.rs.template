use rullst::db::{Orm, RowSnapshot};
use rullst::orm::chrono::{DateTime, Utc};

#[derive(Debug, Clone, Orm)]
#[orm(table = "subscriptions")]
pub struct Subscription {
    pub id: i32,
    pub __FOREIGN_KEY__: i32,
    pub customer_id: String,
    pub subscription_id: String,
    pub plan_id: String,
    pub status: String,
    pub ends_at: Option<i64>,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    // Remembers the loaded values, so `save()` writes only the columns this
    // record changed. Build new records with `snapshot: RowSnapshot::default()`.
    #[sqlx(skip)]
    pub snapshot: RowSnapshot,
}

impl Subscription {
    pub async fn find_by_subscription_id(
        subscription_id: &str,
    ) -> Result<Option<Self>, rullst::orm::Error> {
        Self::query()
            .where_eq("subscription_id", subscription_id.to_string())
            .first()
            .await
    }
}
