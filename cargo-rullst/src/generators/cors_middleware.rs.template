use std::{env, fmt, time::Duration};

use rullst::server::{HeaderValue, Method, Uri, header};
use tower_http::cors::{AllowOrigin, CorsLayer};

pub const ALLOWED_ORIGINS_ENV: &str = "CORS_ALLOWED_ORIGINS";

/// Errors produced while constructing the application's CORS policy.
#[derive(Debug, Clone, PartialEq, Eq)]
#[non_exhaustive]
pub enum CorsConfigError {
    MissingAllowlist,
    EmptyAllowlist,
    WildcardOrigin,
    InvalidOrigin(String),
}

impl fmt::Display for CorsConfigError {
    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::MissingAllowlist => write!(
                formatter,
                "{ALLOWED_ORIGINS_ENV} must contain a comma-separated origin allowlist"
            ),
            Self::EmptyAllowlist => write!(formatter, "the CORS origin allowlist cannot be empty"),
            Self::WildcardOrigin => write!(formatter, "wildcard CORS origins are not allowed"),
            Self::InvalidOrigin(origin) => {
                write!(formatter, "invalid CORS origin in allowlist: {origin}")
            }
        }
    }
}

impl std::error::Error for CorsConfigError {}

/// Explicit, fail-closed CORS configuration.
///
/// Origins not present in `allowed_origins` receive no CORS authorization
/// headers. Credentials are disabled unless explicitly enabled with the
/// builder method.
#[derive(Debug, Clone)]
#[non_exhaustive]
pub struct CorsConfig {
    allowed_origins: Vec<HeaderValue>,
    allow_credentials: bool,
    max_age: Duration,
}

impl CorsConfig {
    pub fn new<I, S>(allowed_origins: I) -> Result<Self, CorsConfigError>
    where
        I: IntoIterator<Item = S>,
        S: AsRef<str>,
    {
        let mut parsed_origins = Vec::new();

        for origin in allowed_origins {
            let origin = origin.as_ref().trim();
            if origin.is_empty() {
                continue;
            }
            if origin == "*" {
                return Err(CorsConfigError::WildcardOrigin);
            }

            let uri = origin
                .parse::<Uri>()
                .map_err(|_| CorsConfigError::InvalidOrigin(origin.to_string()))?;
            let Some(scheme) = uri.scheme_str() else {
                return Err(CorsConfigError::InvalidOrigin(origin.to_string()));
            };
            let Some(authority) = uri.authority() else {
                return Err(CorsConfigError::InvalidOrigin(origin.to_string()));
            };
            if !matches!(scheme, "http" | "https")
                || uri.query().is_some()
                || origin != format!("{scheme}://{authority}")
            {
                return Err(CorsConfigError::InvalidOrigin(origin.to_string()));
            }

            let header_value = origin
                .parse::<HeaderValue>()
                .map_err(|_| CorsConfigError::InvalidOrigin(origin.to_string()))?;
            if !parsed_origins.contains(&header_value) {
                parsed_origins.push(header_value);
            }
        }

        if parsed_origins.is_empty() {
            return Err(CorsConfigError::EmptyAllowlist);
        }

        Ok(Self {
            allowed_origins: parsed_origins,
            allow_credentials: false,
            max_age: Duration::from_secs(86_400),
        })
    }

    pub fn from_env() -> Result<Self, CorsConfigError> {
        let origins =
            env::var(ALLOWED_ORIGINS_ENV).map_err(|_| CorsConfigError::MissingAllowlist)?;
        Self::new(origins.split(','))
    }

    /// Opts in to credentialed CORS requests for the explicit allowlist.
    pub fn with_credentials(mut self, allow_credentials: bool) -> Self {
        self.allow_credentials = allow_credentials;
        self
    }

    pub fn with_max_age(mut self, max_age: Duration) -> Self {
        self.max_age = max_age;
        self
    }

    pub fn into_layer(self) -> CorsLayer {
        let allowed_origins = self.allowed_origins;
        let allow_origin =
            AllowOrigin::predicate(move |origin, _request_parts| allowed_origins.contains(origin));

        CorsLayer::new()
            .allow_origin(allow_origin)
            .allow_methods([
                Method::GET,
                Method::HEAD,
                Method::POST,
                Method::PUT,
                Method::PATCH,
                Method::DELETE,
                Method::OPTIONS,
            ])
            .allow_headers([
                header::CONTENT_TYPE,
                header::AUTHORIZATION,
                header::HeaderName::from_static("x-requested-with"),
                header::HeaderName::from_static("x-csrf-token"),
            ])
            .allow_credentials(self.allow_credentials)
            .max_age(self.max_age)
            .vary([header::ORIGIN])
    }
}

pub fn cors_layer_from_env() -> Result<CorsLayer, CorsConfigError> {
    CorsConfig::from_env().map(CorsConfig::into_layer)
}
