__MIGRATIONS_MOD_DECLARATION__

#[rullst::runtime::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
__ARTISAN_CALL__
    #[cfg(debug_assertions)]
    {
        rullst::runtime::spawn(async {
            if let Err(error) = rullst::studio::run_studio(5555).await {
                eprintln!("Rullst Studio could not start: {error}");
            }
        });
        println!("Rullst Studio running on http://127.0.0.1:5555");
    }

    let is_hot = std::env::var("HOT_RELOAD").is_ok();

    let server = if is_hot {
        let lib_path = if cfg!(target_os = "windows") {
            "target/debug/__PROJECT_NAME_SAFE__"
        } else {
            "target/debug/lib__PROJECT_NAME_SAFE__"
        };
        rullst::Server::new_hot(lib_path)
    } else {
        let router = __PROJECT_NAME_SAFE__::router();
        rullst::Server::new(router)
    };

    server
__SERVER_MIGRATIONS__        // Production monitoring is off. To serve the read-only
        // `GET /_rullst/monitor/v1` document, uncomment the next lines and set
        // RULLST_MONITOR_TOKENS (see .env.example); without a token nothing is
        // mounted. Guide: https://rullst.github.io/Rullst/book/production-monitoring.html
        // .with_monitor(
        //     rullst::monitor::Monitor::new()
        //         .with_application(env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION")),
        // )
        .run(3000)
        .await?;

    Ok(())
}
