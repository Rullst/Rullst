    // Turso is initialized before routes use the global typed model facade.
    // Its settings come from the process environment, then `.env`, which is
    // never loaded into the process, like every other application setting.
    let turso_url = rullst::config::project_setting("TURSO_DATABASE_URL")?.unwrap_or_default();
    // An empty URL selects the offline fallback, a local SQLite file. Staging
    // and production refuse it instead of writing there; an explicit `mock_`
    // value keeps the file on purpose. The environment is the one `Server`
    // resolves, which has not started yet: the process `RULLST_ENV`, then
    // `APP_ENV` (`Environment::detect` reads both), then either one from
    // `.env` (which `project_setting` returns when the process lacks it),
    // then `env` under `[app]` in `Rullst.toml`.
    let configured_environment = match rullst::config::project_setting("RULLST_ENV")? {
        Some(environment) => Some(environment),
        None => rullst::config::project_setting("APP_ENV")?,
    };
    let configured_environment = match configured_environment {
        Some(environment) => Some(environment),
        None => match std::fs::read_to_string("Rullst.toml") {
            Ok(config) => rullst::config::RullstConfig::from_toml(&config)?.app.env,
            Err(error) if error.kind() == std::io::ErrorKind::NotFound => None,
            Err(error) => return Err(error.into()),
        },
    };
    let environment = rullst::config::Environment::detect(configured_environment.as_deref())?;
    if turso_url.trim().is_empty() && environment.requires_secure_defaults() {
        return Err(format!(
            "TURSO_DATABASE_URL is empty or unset in the {environment} environment, so Turso \
             would write a local SQLite file instead of the database; set it, or set a `mock_` \
             value to keep the offline file on purpose"
        )
        .into());
    }
    let turso = rullst_orm::polyglot::TursoConfig::new(
        turso_url,
        rullst::config::project_setting("TURSO_AUTH_TOKEN")?.unwrap_or_default(),
    )
    // Only the offline fallback (an empty or `mock_` URL) uses this file.
    .with_offline_path(
        rullst::config::project_setting("TURSO_OFFLINE_PATH")?
            .unwrap_or_else(|| "turso-development.db".to_owned()),
    )?
    // A local libSQL server (`turso dev`, `sqld`) answers plain HTTP, such as
    // http://127.0.0.1:8080; any other `http://` endpoint is still refused.
    .allow_insecure_loopback();
    rullst_orm::polyglot::TursoOrm::init(turso).await?;
    if let Some(command) = std::env::args().nth(1) {
        match command.as_str() {
            "db:migrate" => {
                let report = rullst_orm::polyglot::TursoOrm::migrate(
                    crate::migrations::get_migrations()?,
                ).await?;
                println!("Applied {} Turso migration(s); {} already current.", report.applied.len(), report.skipped.len());
                return Ok(());
            }
            "db:rollback" => {
                let report = rullst_orm::polyglot::TursoOrm::rollback_last(
                    crate::migrations::get_migrations()?,
                ).await?;
                match report.rolled_back {
                    Some(name) => println!("Rolled back Turso migration {name}."),
                    None => println!("No Turso migrations to roll back."),
                }
                return Ok(());
            }
            "db:status" => {
                let applied = rullst_orm::polyglot::TursoOrm::migration_status().await?;
                if applied.is_empty() {
                    println!("No Turso migrations applied.");
                } else {
                    for name in applied { println!("[applied] {name}"); }
                }
                return Ok(());
            }
            "db:seed" => {
                println!("No Turso seeders are configured in this blank starter.");
                return Ok(());
            }
            _ => {}
        }
    }
