use rullst::{routes, Router, Server};

pub mod migrations;
pub mod models;
__REPO_MOD_DECL__pub mod controllers;
pub mod pages;

fn router() -> Result<Router, Box<dyn std::error::Error>> {
    // Nexus fails closed, but the site still starts: a release build without
    // NEXUS_ADMIN_USERNAME and NEXUS_ADMIN_PASSWORD serves it without `/nexus`.
    let nexus = match rullst::nexus::NexusAuthPolicy::local_development_or_basic_from_env() {
        Ok(nexus_auth) => Some(
            rullst::nexus::Nexus::new()
                .with_auth_policy(nexus_auth)
                .with_brand("Blog Admin")
                .register::<models::post::Post>()
                .try_build()?,
        ),
        Err(rullst::nexus::NexusBuildError::MissingCredential { variable }) => {
            eprintln!("Nexus is not mounted at /nexus: {variable} is not set; set NEXUS_ADMIN_USERNAME and NEXUS_ADMIN_PASSWORD (at least 16 characters) to enable it");
            None
        }
        Err(error) => return Err(error.into()),
    };

    let router = routes![
        get("/" => controllers::blog_controller::index),
        // rullst-access: public — published blog posts are intentionally public resources.
        get("/posts/{slug}" => controllers::blog_controller::show),
        get("/robots.txt" => controllers::blog_controller::robots_txt),
        get("/sitemap.xml" => controllers::blog_controller::sitemap_xml),
    ]
    // `/health` and `/ready` for container, Kubernetes and PaaS probes.
    .merge_axum(rullst::health::health_router());
    Ok(match nexus {
        Some(nexus) => router.nest_axum("/nexus", nexus),
        None => router,
    })
}

#[rullst::runtime::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    // Runs an Artisan command such as `db:migrate` and exits; a plain start applies no migrations.
    rullst::artisan!(crate::migrations::get_migrations());
    let router = router()?;

    #[cfg(debug_assertions)]
    {
        rullst::runtime::spawn(async {
            if let Err(error) = rullst::studio::run_studio(5555).await {
                eprintln!("Rullst Studio could not start: {error}");
            }
        });
        println!("📊 Rullst Studio running on http://127.0.0.1:5555");
    }
    println!("🚀 Blog server starting on port 3000...");
    Server::new(router)
        .run(3000)
        .await?;

    Ok(())
}

