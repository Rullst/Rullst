use rullst::db::{Orm, RowSnapshot};
use rullst::orm::Timestamp;
use rullst::nexus::{NexusModel, FieldMeta, FieldKind};

#[derive(Debug, Clone, Default, Orm)]
#[orm(table = "users")]
pub struct User {
    pub id: i32,
    pub name: String,
    pub email: String,
    // Keeps the Argon2 hash out of `to_json()`, which feeds audit rows and
    // the post-commit Redis model events.
    #[orm(hidden)]
    pub password_hash: Option<String>,
    pub oauth_provider: Option<String>,
    pub oauth_id: Option<String>,
    pub created_at: Timestamp,
    pub updated_at: Timestamp,
    // Lets this account into Nexus (`/nexus`) under the application's
    // sign-in. The database manages this column: ORM inserts and saves never
    // write it, so neither a form nor `save()` grants it, while queries can
    // still filter on it (`where_eq("is_admin", true)`). Set it to true with
    // your database client for the first administrator, who can then grant
    // others in Nexus.
    #[orm(db_default)]
    pub is_admin: bool,
    // Login cookies carry the epoch they were issued with. ORM inserts and
    // saves never write this column, so `save()` never undoes
    // `revoke_sessions`.
    #[orm(db_default)]
    pub session_epoch: i64,
    // Remembers the loaded values, so `save()` writes only the columns this
    // record changed. Build new records with `snapshot: RowSnapshot::default()`.
    #[sqlx(skip)]
    pub snapshot: RowSnapshot,
}

impl User {
    pub async fn find_by_email(email: &str) -> Result<Option<Self>, rullst_orm::Error> {
        Self::query()
            .where_eq("email", email.to_owned())
            .first()
            .await
    }
__RULLST_SESSION_EPOCH_METHODS__}

impl NexusModel for User {
    fn nexus_table() -> &'static str { "users" }
    fn nexus_label() -> &'static str { "Users" }
    fn nexus_icon() -> &'static str { "👥" }
    fn nexus_fields() -> Vec<FieldMeta> {
        vec![
            FieldMeta::new("id", "ID", FieldKind::Number).hidden().readonly(),
            FieldMeta::new("name", "Name", FieldKind::Text),
            FieldMeta::new("email", "Email", FieldKind::Text),
            FieldMeta::new("password_hash", "Password Hash", FieldKind::Text).hidden(),
            FieldMeta::new("oauth_provider", "OAuth Provider", FieldKind::Text),
            FieldMeta::new("oauth_id", "OAuth ID", FieldKind::Text),
            FieldMeta::new("is_admin", "Nexus administrator", FieldKind::Boolean),
            FieldMeta::new("created_at", "Created At", FieldKind::DateTimeUtc).readonly(),
            FieldMeta::new("updated_at", "Updated At", FieldKind::DateTimeUtc).readonly(),
        ]
    }
}
