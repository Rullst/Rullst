    fn nexus_label() -> &'static str { "Subscriptions" }
    fn nexus_icon() -> &'static str { "💳" }
    fn nexus_fields() -> Vec<FieldMeta> {
        vec![
            FieldMeta::new("id", "ID", FieldKind::Number).hidden().readonly(),
            FieldMeta::new("user_id", "User ID", FieldKind::Number),
            FieldMeta::new("customer_id", "Customer ID", FieldKind::Text),
            FieldMeta::new("subscription_id", "Subscription ID", FieldKind::Text),
            FieldMeta::new("plan_id", "Plan ID", FieldKind::Text),
            FieldMeta::new("status", "Status", FieldKind::Text),
            FieldMeta::new("ends_at", "Ends At", FieldKind::Number),
            FieldMeta::new("created_at", "Created At", FieldKind::DateTimeUtc).readonly(),
            FieldMeta::new("updated_at", "Updated At", FieldKind::DateTimeUtc).readonly(),
        ]
    }
}
