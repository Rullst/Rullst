use rullst::server::{Extension, IntoResponse, Response, StatusCode};
use rullst::response::Html;
use crate::repositories::profile_repository::ProfileRepository;
use crate::repositories::project_repository::ProjectRepository;
use crate::repositories::experience_repository::ExperienceRepository;
use crate::repositories::skill_repository::SkillRepository;
use crate::pages::home;

/// The production security headers allow only nonce-bound inline styles; the
/// nonce is absent (and unneeded) when no CSP is sent, as in development.
fn nonce(csp_nonce: &Option<Extension<rullst::security::CspNonce>>) -> &str {
    csp_nonce
        .as_ref()
        .map(|Extension(nonce)| nonce.as_str())
        .unwrap_or_default()
}

/// A failed query is an outage, not an empty portfolio.
fn unavailable(error: rullst_orm::Error) -> Response {
    eprintln!("Portfolio query failed: {error}");
    StatusCode::SERVICE_UNAVAILABLE.into_response()
}

pub async fn index(
    csp_nonce: Option<Extension<rullst::security::CspNonce>>,
) -> Response {
    // Without a profile nobody's identity is shown.
    let profile = match ProfileRepository::get().await {
        Ok(Some(profile)) => profile,
        Ok(None) => {
            return (StatusCode::NOT_FOUND, "No portfolio profile exists yet. Create one in Nexus.")
                .into_response();
        }
        Err(error) => return unavailable(error),
    };
    let projects = match ProjectRepository::all().await {
        Ok(projects) => projects,
        Err(error) => return unavailable(error),
    };
    let experiences = match ExperienceRepository::all().await {
        Ok(experiences) => experiences,
        Err(error) => return unavailable(error),
    };
    let skills = match SkillRepository::all().await {
        Ok(skills) => skills,
        Err(error) => return unavailable(error),
    };

    Html(home::render(&profile, &projects, &experiences, &skills, nonce(&csp_nonce))).into_response()
}
