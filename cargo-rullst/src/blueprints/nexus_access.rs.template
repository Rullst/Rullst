//! Lets the application's administrators into Nexus (`/nexus`) with their
//! login session in release builds; debug builds keep Nexus on loopback.
use crate::middlewares::auth_middleware::signed_in;
use rullst::nexus::{NexusAccess, NexusAuthorizer, NexusAuthorizerError};
use rullst::web::axum::http::request::Parts;

/// Signed-in users whose `is_admin` column is true. Nexus asks on every
/// request, so signing out, revoking the session in "Your devices", "sign
/// out everywhere" or clearing `is_admin` takes effect on the next one.
pub struct NexusAdmins;

impl NexusAuthorizer for NexusAdmins {
    async fn authorize(&self, request: &Parts) -> Result<NexusAccess, NexusAuthorizerError> {
        match signed_in(&request.headers).await {
            Ok(Some((user, _))) if user.is_admin => Ok(NexusAccess::allow(format!("user:{}", user.id))),
            Ok(Some(_)) => Ok(NexusAccess::Deny),
            // No session, or a revoked one.
            Ok(None) => Ok(NexusAccess::SignIn),
            Err(_) => Err(NexusAuthorizerError::new("the session or user lookup failed")),
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[tokio::test]
    async fn a_request_without_a_session_is_sent_to_sign_in() {
        let (request, ()) = rullst::web::axum::http::Request::get("/nexus")
            .body(())
            .expect("request")
            .into_parts();
        assert_eq!(NexusAdmins.authorize(&request).await, Ok(NexusAccess::SignIn));
    }
}
