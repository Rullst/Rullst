use rullst::db::{FromRow, Orm};
use rullst::orm::chrono::{DateTime, Utc};
use rullst::nexus::{FieldKind, FieldMeta, NexusModel};

#[derive(Debug, Clone, Default, FromRow, Orm)]
#[orm(table = "users")]
pub struct User {
    pub id: i32,
    pub name: String,
    pub email: String,
    #[orm(hidden)]
    pub password_hash: Option<String>,
    pub oauth_provider: Option<String>,
    pub oauth_id: Option<String>,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    // Lets this account into Nexus (`/nexus`) under the application's
    // sign-in. ORM writes skip this column, so neither a form nor a full-row
    // save grants it: set it to true with your database client for the first
    // administrator, who can then grant others in Nexus.
    #[orm(skip)]
    pub is_admin: bool,
    // Login cookies carry the epoch they were issued with. ORM writes skip
    // this column, so a full-row save never undoes `revoke_sessions`.
    #[orm(skip)]
    pub session_epoch: i64,
}

impl User {
    pub async fn find_by_email(email: &str) -> Result<Option<Self>, rullst_orm::Error> {
        Self::query()
            .where_eq("email", email.to_owned())
            .first()
            .await
    }
__RULLST_SESSION_EPOCH_METHODS__}

impl NexusModel for User {
    fn nexus_table() -> &'static str { "users" }
    fn nexus_label() -> &'static str { "Learners" }
    fn nexus_icon() -> &'static str { "👥" }
    fn nexus_fields() -> Vec<FieldMeta> {
        vec![
            FieldMeta { name: "id", label: "ID", kind: FieldKind::Number, hidden: true, readonly: true },
            FieldMeta { name: "name", label: "Name", kind: FieldKind::Text, hidden: false, readonly: false },
            FieldMeta { name: "email", label: "Email", kind: FieldKind::Text, hidden: false, readonly: false },
            FieldMeta { name: "password_hash", label: "Password Hash", kind: FieldKind::Text, hidden: true, readonly: true },
            FieldMeta { name: "oauth_provider", label: "OAuth Provider", kind: FieldKind::Text, hidden: false, readonly: true },
            FieldMeta { name: "oauth_id", label: "OAuth ID", kind: FieldKind::Text, hidden: true, readonly: true },
            FieldMeta { name: "is_admin", label: "Nexus administrator", kind: FieldKind::Boolean, hidden: false, readonly: false },
            FieldMeta { name: "created_at", label: "Created At", kind: FieldKind::DateTimeUtc, hidden: false, readonly: true },
            FieldMeta { name: "updated_at", label: "Updated At", kind: FieldKind::DateTimeUtc, hidden: false, readonly: true },
        ]
    }
}
