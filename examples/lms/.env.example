APP_KEY=REPLACE_WITH_YOUR_32_CHAR_RANDOM_KEY
RULLST_ENV=development

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite://db.sqlite?mode=rwc

# ── Mail ──────────────────────────────────────────────────────
# The Mail facade reads these from the process environment, then this file.
# Default sender for messages without `from`, e.g. MAIL_FROM="App <no-reply@example.com>";
# use an address your mail provider has verified.
MAIL_FROM=
# Staging/production must select a driver before sending mail, e.g.:
# MAIL_DRIVER=resend

# ── Nexus Admin ──
# Release builds open /nexus to signed-in users whose `is_admin` is true; no
# NEXUS_ADMIN_* credentials are used. Grant the first administrator with
# UPDATE users SET is_admin = TRUE WHERE email = 'you@example.com';

# ── Public origin ──
# Canonical HTTPS origin (no path) that password reset emails link to, e.g.
# https://app.example.com. Unset, development links use http://localhost:3000
# and staging/production send no reset link.
RULLST_PUBLIC_ORIGIN=
# Product name in the subject and heading of account emails; unset, the
# package name is used.
APP_NAME=

# ── Production monitor (off) ──
# Bearer tokens for GET /_rullst/monitor/v1, read only after you uncomment
# `with_monitor` in src/main.rs. Use at least 32 random bytes per token, e.g.
# `openssl rand -base64 32`; separate several with commas. Guide:
# https://rullst.github.io/Rullst/book/production-monitoring.html
# RULLST_MONITOR_TOKENS=
